# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Database and Storage Settings
DATABASE_PATH=./memory/executive_team.db
WORKSPACE_ROOT=./workspace

# Security & Telegram Integrations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
API_SECRET_KEY=generate_with_openssl_rand_hex_32
SANDBOX_MODE=True
LOG_LEVEL=INFO

# Optional public-domain allowlist for approved browser actions.
# Empty still blocks loopback/private/link-local destinations.
ALLOWED_BROWSER_DOMAINS=

# API is loopback-only by default. Do not set a LAN/public bind unless you
# also provide TLS/private tunneling, or explicitly acknowledge plaintext risk.
BIND_HOST=127.0.0.1
ALLOW_INSECURE_REMOTE_HTTP=False

# Sending executive prompts/memory to a non-loopback model endpoint requires
# an explicit privacy opt-in.
ALLOW_REMOTE_LLM=False

# Telegram notifications keep detailed execution paths/errors local by default.
TELEGRAM_INCLUDE_SENSITIVE_DETAILS=False
TELEGRAM_ALLOW_REMOTE_CONTROL=False

# Required by CrewAI's OpenAI-compatible client even though Ollama never
# checks this value — any non-empty placeholder works. See README.
OPENAI_API_KEY=ollama-local-not-a-real-key

# Optional dedicated HMAC key for cross-machine JSONL sync integrity.
# If empty, API_SECRET_KEY is used.
SYNC_HMAC_KEY=

# Raw shell is heuristic and not a true OS sandbox. Keep disabled unless
# explicitly accepting that residual risk.
ALLOW_UNSAFE_RAW_SHELL=False

# Local-first privacy: CrewAI telemetry is disabled by default.
CREWAI_DISABLE_TELEMETRY=true
